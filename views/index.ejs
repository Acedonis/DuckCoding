<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DuckCoding — Plataforma de Bots</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <nav class="top-menu">
    <div class="nav-brand">
      <span class="duck-icon">🦆</span>
      <span class="brand-name">DuckCoding</span>
    </div>
    <ul>
      <li><a href="#funcionalidades">Funcionalidades</a></li>
      <li><a href="#contato">Contato</a></li>
      <li><a href="/login">Entrar</a></li>
      <li><a href="/login" class="nav-cta">Começar →</a></li>
    </ul>
  </nav>

  <section id="inicio" class="hero">
    <div class="hero-decoration">
      <div class="glow-orb orb1"></div>
      <div class="glow-orb orb2"></div>
    </div>
    <div class="hero-content">
      <p class="hero-label">// Plataforma de bots</p>
      <h1>Escreve código.<br><em>Faz deploy.</em><br>Domina.</h1>
      <p class="hero-sub">Cria, gere e faz deploy dos teus bots diretamente no browser. Python, JavaScript, Java — tudo suportado.</p>
      <div class="hero-actions">
        <a href="/login" class="btn-hero">Criar conta grátis →</a>
        <a href="#funcionalidades" class="btn-hero-ghost">Ver funcionalidades</a>
      </div>
      <div class="terminal-block">
        <div class="terminal-bar">
          <div class="terminal-dot r"></div>
          <div class="terminal-dot y"></div>
          <div class="terminal-dot g"></div>
        </div>
        <div class="terminal-line">
          <span class="terminal-prompt">$</span>
          <span class="terminal-cmd" id="typewriter"></span>
          <span class="terminal-cursor" id="cursor"></span>
        </div>
        <div class="terminal-line" id="terminal-out" style="opacity:0; margin-top:4px;">
          <span class="terminal-out">✓ Bot deployed successfully on port 8080</span>
        </div>
      </div>
    </div>
  </section>

  <section id="funcionalidades">
    <div class="section-header">
      <h2>Tudo o que precisas</h2>
      <p>Uma plataforma completa para os teus bots</p>
    </div>
    <div class="features-grid">
      <div class="feature-card">
        <span class="feature-icon">⚡</span>
        <h3>Deploy instantâneo</h3>
        <p>Faz upload do teu código e lança o bot em segundos. Sem configurações complicadas.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">🖥️</span>
        <h3>Editor integrado</h3>
        <p>Escreve e edita código diretamente no browser com syntax highlighting completo.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">📡</span>
        <h3>Logs em tempo real</h3>
        <p>Monitoriza o teu bot ao vivo. Vê cada linha de output à medida que acontece.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">🐍</span>
        <h3>Multi-linguagem</h3>
        <p>Suporte para Python, JavaScript, Java e mais. Usa a linguagem que preferes.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">🔐</span>
        <h3>Login com Google</h3>
        <p>Sem passwords para lembrar. Entra com a tua conta Google em segundos.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">🆓</span>
        <h3>Completamente grátis</h3>
        <p>Sem cartão de crédito. Sem limite de tempo. Começa a construir hoje.</p>
      </div>
    </div>
  </section>

  <section id="cta" style="text-align:center; padding: 80px 32px;">
    <p class="hero-label">// Pronto para começar?</p>
    <h2 style="font-size: clamp(1.8rem, 4vw, 2.8rem); margin: 0 0 16px;">O teu próximo bot<br><em style="color: var(--accent-bright); font-style:normal;">começa aqui.</em></h2>
    <p style="color: var(--text-muted); margin: 0 auto 36px; max-width: 400px; font-size: 0.95rem; line-height: 1.7;">Junta-te a outros developers que já usam o DuckCoding para gerir os seus bots.</p>
    <a href="/login" class="btn-hero">Criar conta grátis →</a>
  </section>

  <section id="contato">
    <div class="section-header">
      <h2>Contato</h2>
      <p>Alguma questão? Fala connosco</p>
    </div>
    <div class="contact-card">
      <div class="contact-item">
        <span class="contact-icon">✉️</span>
        <div>
          <strong>Email</strong>
          <a href="mailto:duckcoding@example.com">duckcoding@example.com</a>
        </div>
      </div>
      <button class="btn-primary" onclick="window.location.href='mailto:duckcoding@example.com'">
        Enviar mensagem
      </button>
    </div>
  </section>

  <footer>
    <span class="duck-icon">🦆</span>
    <span>&copy; 2026 DuckCoding — Todos os direitos reservados.</span>
  </footer>

  <script>
    const lines = [
      { cmd: "duckcoding deploy bot.py --lang python", out: true },
      { cmd: "duckcoding logs my-bot --live", out: false },
      { cmd: "duckcoding status", out: false },
    ];
    let lineIdx = 0;
    let charIdx = 0;
    let isDeleting = false;
    let isPaused = false;
    const el = document.getElementById("typewriter");
    const outEl = document.getElementById("terminal-out");
    function type() {
      const current = lines[lineIdx].cmd;
      if (isPaused) {
        isPaused = false;
        isDeleting = true;
        outEl.style.opacity = "0";
        setTimeout(type, 800);
        return;
      }
      if (!isDeleting) {
        el.textContent = current.slice(0, charIdx + 1);
        charIdx++;
        if (charIdx === current.length) {
          if (lines[lineIdx].out) outEl.style.opacity = "1";
          isPaused = true;
          setTimeout(type, 2000);
          return;
        }
        setTimeout(type, 55);
      } else {
        el.textContent = current.slice(0, charIdx - 1);
        charIdx--;
        if (charIdx === 0) {
          isDeleting = false;
          lineIdx = (lineIdx + 1) % lines.length;
          setTimeout(type, 400);
          return;
        }
        setTimeout(type, 25);
      }
    }
    setTimeout(type, 1200);
  </script>
</body>
</html>
