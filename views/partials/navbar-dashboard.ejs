<nav class="top-menu">
  <button class="hamburger-btn" id="hamburger-btn" aria-label="menu">
    <span></span><span></span><span></span>
  </button>

  <div class="nav-brand">
    <span class="duck-icon">🦆</span>
    duckcoding
  </div>

  <div class="nav-right">
    <div class="nav-search">
      <span class="search-icon">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </span>
      <input type="text" placeholder="pesquisar bots..." id="search-input" />
      <span class="kbd">⌘K</span>
    </div>

    <div class="nav-notif">
      <button class="notif-btn" id="notif-btn" aria-label="notificações">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <span class="notif-badge" id="notif-badge" style="display:none;">0</span>
      </button>

      <div class="notif-dropdown" id="notif-dropdown">
        <div class="notif-panel-header">
          <div class="notif-panel-left">
            <span class="notif-panel-title">notificações</span>
            <span class="notif-count-badge" id="notif-count-badge" style="display:none;">0</span>
          </div>
          <button class="notif-mark-read" id="notif-mark-read">marcar como lidas</button>
        </div>

        <div class="notif-tabs">
          <button class="notif-tab active" data-tab="novas">não lidas</button>
          <button class="notif-tab" data-tab="atualizacoes">
            atualizações
            <span class="notif-update-badge" id="update-badge" style="display:none;">0</span>
          </button>
        </div>

        <div class="notif-list" id="notif-list"></div>

        <div class="notif-footer">
          <a href="#" id="notif-footer-link">ver histórico</a>
        </div>
      </div>
    </div>

    <div class="nav-sep"></div>

    <div class="user-menu">
      <div class="user-trigger" id="user-trigger">
        <img
          src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.username) + '&background=0a0a0a&color=fff&bold=true&rounded=true' %>"
          alt="avatar"
          class="user-avatar-img"
        >
        <span class="user-name"><%= user.username %></span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.3;">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </div>
      <div class="dropdown-menu" id="dropdown-menu">
        <div class="dropdown-header">
          <div class="dropdown-username"><%= user.username %></div>
          <div class="dropdown-email"><%= user.email || '' %></div>
        </div>
        <div class="dropdown-sep"></div>
        <a href="/profile" class="dropdown-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          perfil
        </a>
        <a href="/settings" class="dropdown-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
          definições
        </a>
        <div class="dropdown-sep"></div>
        <a href="/logout" class="dropdown-item dropdown-item-danger">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          sair
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Overlay da sidebar -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <span class="duck-icon">🦆</span>
    duckcoding
  </div>

  <nav class="sidebar-nav">
    <div class="sidebar-nav-label">geral</div>
    <a href="/dashboard" class="sidebar-nav-item <%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      dashboard
    </a>
    <a href="/dashboard#bots" class="sidebar-nav-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      os meus bots
      <span class="nav-badge" id="sidebar-bots-count">0</span>
    </a>
    <a href="/editor" class="sidebar-nav-item <%= typeof page !== 'undefined' && page === 'editor' ? 'active' : '' %>">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
      editor de código
    </a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-nav-label">conta</div>

    <a href="/profile" class="sidebar-nav-item <%= typeof page !== 'undefined' && page === 'profile' ? 'active' : '' %>">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      perfil
    </a>
    <a href="/settings" class="sidebar-nav-item <%= typeof page !== 'undefined' && page === 'settings' ? 'active' : '' %>">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
      definições
    </a>
    <a href="/notifications" class="sidebar-nav-item <%= typeof page !== 'undefined' && page === 'notifications' ? 'active' : '' %>">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      histórico de notificações
      <span class="nav-badge" id="sidebar-notif-count" style="display:none;"></span>
    </a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-nav-label">recursos</div>

    <a href="/docs" class="sidebar-nav-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      documentação
    </a>
    <a href="/support" class="sidebar-nav-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      suporte
    </a>
  </nav>

  <div class="sidebar-footer">
    <a href="/logout" class="sidebar-footer-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      sair
    </a>
  </div>
</aside>

<script>
(function() {
  // ── Sidebar ──
  const hamburger = document.getElementById('hamburger-btn');
  const sidebar   = document.getElementById('sidebar');
  const overlay   = document.getElementById('sidebar-overlay');

  function openSidebar()  { sidebar.classList.add('open');    overlay.classList.add('open'); }
  function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('open'); }

  hamburger.addEventListener('click', function(e) {
    e.stopPropagation();
    sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
  });
  overlay.addEventListener('click', closeSidebar);

  // ── User dropdown ──
  const userTrigger = document.getElementById('user-trigger');
  const dropdown    = document.getElementById('dropdown-menu');

  userTrigger.addEventListener('click', function(e) {
    e.stopPropagation();
    const isOpen = dropdown.classList.toggle('open');
    if (isOpen) closeNotif();
  });

  // ── Notifications ──
  const notifBtn      = document.getElementById('notif-btn');
  const notifDropdown = document.getElementById('notif-dropdown');
  const notifBadge    = document.getElementById('notif-badge');
  const countBadge    = document.getElementById('notif-count-badge');
  const updateBadge   = document.getElementById('update-badge');
  const sidebarNotif  = document.getElementById('sidebar-notif-count');

  const notifications = [
    { id: 1, read: false, type: 'danger',  text: 'bot <strong>meu-bot</strong> parou inesperadamente', time: 'há 5 min' },
    { id: 2, read: false, type: 'success', text: 'deploy concluído com sucesso', time: 'há 1 hora' },
  ];

  const updates = [
    { id: 1, read: false, tag: 'new',   tagLabel: 'novidade',   title: 'novo menu lateral',      desc: 'Navegação lateral disponível em todas as páginas.', time: 'hoje' },
    { id: 2, read: true,  tag: 'fix',   tagLabel: 'correção',   title: 'editor mais estável',    desc: 'Corrigido crash ao guardar ficheiros grandes.',      time: '27 mar' },
    { id: 3, read: true,  tag: 'manut', tagLabel: 'manutenção', title: 'migração de servidores', desc: 'Melhoria de desempenho na infraestrutura.',          time: '20 mar' },
  ];

  const icons = {
    danger:  '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--red)"     stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',
    success: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--green)"   stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>',
    info:    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--text-dim)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
    warning: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--orange)"  stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>',
    update:  '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"   stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>',
  };

  let currentTab = 'novas';

  function refreshBadges() {
    const unread        = notifications.filter(n => !n.read).length;
    const unreadUpdates = updates.filter(u => !u.read).length;
    const total         = unread + unreadUpdates;

    notifBadge.textContent   = total;
    notifBadge.style.display = total > 0 ? 'flex' : 'none';
    countBadge.textContent   = unread;
    countBadge.style.display = unread > 0 ? 'inline' : 'none';
    updateBadge.textContent  = unreadUpdates;
    updateBadge.style.display = unreadUpdates > 0 ? 'inline' : 'none';
    if (sidebarNotif) {
      sidebarNotif.textContent  = total;
      sidebarNotif.style.display = total > 0 ? 'inline' : 'none';
    }
  }

  function renderNotifs() {
    const list      = document.getElementById('notif-list');
    const markRead  = document.getElementById('notif-mark-read');
    const footerBtn = document.getElementById('notif-footer-link');

    markRead.style.display = currentTab === 'novas' ? 'inline' : 'none';
    footerBtn.textContent  = currentTab === 'novas' ? 'ver histórico' : 'ver todas';

    if (currentTab === 'novas') {
      const filtered = notifications.filter(n => !n.read);
      if (!filtered.length) {
        list.innerHTML = '<div class="notif-empty">sem notificações não lidas</div>';
        return;
      }
      list.innerHTML = filtered.map(n => `
        <div class="notif-item-row" data-id="${n.id}" data-type="notif">
          <div class="notif-dot-col"><div class="notif-dot"></div></div>
          <div class="notif-icon-col notif-icon-${n.type}">${icons[n.type]}</div>
          <div class="notif-body">
            <div class="notif-text">${n.text}</div>
            <div class="notif-time">${n.time}</div>
          </div>
        </div>`).join('');
    } else {
      list.innerHTML = updates.map(u => `
        <div class="notif-item-row" data-id="${u.id}" data-type="update">
          <div class="notif-dot-col"><div class="notif-dot ${u.read ? 'read' : ''}"></div></div>
          <div class="notif-icon-col notif-icon-update">${icons.update}</div>
          <div class="notif-body">
            <span class="notif-update-tag notif-tag-${u.tag}">${u.tagLabel}</span>
            <div class="notif-text"><strong>${u.title}</strong></div>
            <div class="notif-text notif-text-dim">${u.desc}</div>
            <div class="notif-time">${u.time}</div>
          </div>
        </div>`).join('');
    }

    list.querySelectorAll('.notif-item-row').forEach(el => {
      el.addEventListener('click', function() {
        const id = parseInt(this.dataset.id);
        if (this.dataset.type === 'notif') {
          const n = notifications.find(x => x.id === id);
          if (n) n.read = true;
        } else {
          const u = updates.find(x => x.id === id);
          if (u) u.read = true;
        }
        refreshBadges();
        renderNotifs();
      });
    });
  }

  function openNotif() {
    notifDropdown.classList.add('open');
    dropdown.classList.remove('open');
    renderNotifs();
  }
  function closeNotif() { notifDropdown.classList.remove('open'); }

  notifBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    notifDropdown.classList.contains('open') ? closeNotif() : openNotif();
  });

  document.getElementById('notif-mark-read').addEventListener('click', function(e) {
    e.preventDefault();
    notifications.forEach(n => n.read = true);
    refreshBadges(); renderNotifs();
  });

  document.getElementById('notif-footer-link').addEventListener('click', function(e) {
    e.preventDefault();
    if (currentTab === 'novas') {
      currentTab = 'atualizacoes';
      document.querySelectorAll('.notif-tab').forEach(t => t.classList.remove('active'));
      document.querySelector('[data-tab="atualizacoes"]').classList.add('active');
      renderNotifs();
    } else {
      window.location.href = '/notifications';
    }
  });

  document.querySelectorAll('.notif-tab').forEach(tab => {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.notif-tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      currentTab = this.dataset.tab;
      renderNotifs();
    });
  });

  // ── Fechar tudo ao clicar fora ──
  window.addEventListener('click', function() {
    dropdown.classList.remove('open');
    closeNotif();
    closeSidebar();
  });

  notifDropdown.addEventListener('click', e => e.stopPropagation());
  dropdown.addEventListener('click',      e => e.stopPropagation());
  sidebar.addEventListener('click',       e => e.stopPropagation());

  // ── Search ──
  const searchInput = document.getElementById('search-input');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      const q = this.value.toLowerCase();
      document.querySelectorAll('.bot-item').forEach(function(item) {
        const name = item.querySelector('h4')?.textContent.toLowerCase() || '';
        item.style.display = name.includes(q) ? '' : 'none';
      });
    });
  }

  // ── Contagem de bots na sidebar ──
  const botsCount     = document.querySelectorAll('.bot-item').length;
  const sidebarBotsEl = document.getElementById('sidebar-bots-count');
  if (sidebarBotsEl) sidebarBotsEl.textContent = botsCount;

  refreshBadges();
})();
</script>
