<!DOCTYPE html>
<html lang="pt">
<head>
  <%- include('partials/head') %>
  <title>DuckCoding — dashboard</title>
</head>
<body>

<%- include('partials/navbar-dashboard') %>

<div class="dash-hero">
  <div class="dash-hero-inner">
    <div class="dash-greeting">
      <div class="greeting-tag"><span class="tag-dot"></span> sistema operacional</div>
      <h1>olá, <em><%= user.username %></em></h1>
      <p>// <%= bots.length %> bot<%= bots.length !== 1 ? 's' : '' %> registado<%= bots.length !== 1 ? 's' : '' %></p>
      <div class="status-strip">
        <div class="s-item">
          <div class="s-dot"></div>
          <span class="s-label">status</span>
          <span class="s-val">online</span>
        </div>
        <div class="s-sep"></div>
        <div class="s-item">
          <span class="s-label">bots</span>
          <span class="s-val"><%= String(bots.length).padStart(2,'0') %></span>
        </div>
        <div class="s-sep"></div>
        <div class="s-item">
          <span class="s-label">região</span>
          <span class="s-val">EU-WEST</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="dash-content">
  <div class="dash-grid">
    <%- include('partials/dashboard/panel-upload') %>
    <%- include('partials/dashboard/panel-editor') %>
  </div>
  <%- include('partials/dashboard/bots-list') %>
</div>

<%- include('partials/footer') %>
<%- include('partials/dashboard/scripts') %>

</body>
</html>
