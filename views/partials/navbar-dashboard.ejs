<nav class="top-menu">
  <div class="nav-brand">
    <span class="duck-icon">🦆</span>
    duckcoding
  </div>

  <ul>
    <li><a href="/dashboard">dashboard</a></li>
    <li><a href="/dashboard#bots">os meus bots</a></li>
    <li><a href="/editor">editor</a></li>
    <li><a href="/editor" class="nav-cta">+ novo bot</a></li>
  </ul>

  <div class="nav-right">
    <div class="nav-search">
      <span class="search-icon">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </span>
      <input type="text" placeholder="pesquisar..." id="search-input" />
      <span class="kbd">⌘K</span>
    </div>

    <div class="nav-notif">
      <button class="notif-btn" id="notif-btn" aria-label="notificações">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <span class="notif-badge" id="notif-badge">2</span>
      </button>
      <div class="notif-dropdown" id="notif-dropdown">
        <div class="notif-header">notificações</div>
        <div class="notif-item unread">
          <span class="notif-dot"></span>
          <div>
            <p>bot <strong>meu-bot</strong> parou inesperadamente</p>
            <span>há 5 min</span>
          </div>
        </div>
        <div class="notif-item unread">
          <span class="notif-dot"></span>
          <div>
            <p>deploy concluído com sucesso</p>
            <span>há 1 hora</span>
          </div>
        </div>
        <div class="notif-footer">
          <a href="#" onclick="clearNotifs(event)">marcar todas como lidas</a>
        </div>
      </div>
    </div>

    <div class="nav-sep"></div>

    <div class="user-menu">
      <div class="user-trigger" id="user-trigger">
        <img
          src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.username) + '&background=2563eb&color=fff&bold=true&rounded=true' %>"
          alt="avatar"
          class="user-avatar-img"
        >
        <span class="user-name"><%= user.username %></span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </div>
      <div class="dropdown-menu" id="dropdown-menu">
        <a href="/logout">sair →</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const userTrigger = document.getElementById("user-trigger");
  const dropdown = document.getElementById("dropdown-menu");
  const notifBtn = document.getElementById("notif-btn");
  const notifDropdown = document.getElementById("notif-dropdown");

  userTrigger.addEventListener("click", function(e) {
    e.stopPropagation();
    dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
    notifDropdown.style.display = "none";
  });

  notifBtn.addEventListener("click", function(e) {
    e.stopPropagation();
    notifDropdown.style.display = notifDropdown.style.display === "block" ? "none" : "block";
    dropdown.style.display = "none";
  });

  window.addEventListener("click", function() {
    dropdown.style.display = "none";
    notifDropdown.style.display = "none";
  });

  function clearNotifs(e) {
    e.preventDefault();
    document.querySelectorAll(".notif-item").forEach(el => el.classList.remove("unread"));
    document.querySelectorAll(".notif-dot").forEach(el => el.style.opacity = "0");
    document.getElementById("notif-badge").style.display = "none";
  }

  document.getElementById("search-input").addEventListener("input", function() {
    const q = this.value.toLowerCase();
    document.querySelectorAll(".bot-item").forEach(function(item) {
      const name = item.querySelector("h4")?.textContent.toLowerCase() || "";
      item.style.display = name.includes(q) ? "" : "none";
    });
  });
</script>
