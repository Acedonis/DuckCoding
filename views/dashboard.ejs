<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DuckCoding — dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="top-menu">
  <div class="nav-brand">
    <span class="duck-icon">🦆</span>
    duckcoding
  </div>
  <ul>
    <li><a href="/dashboard">dashboard</a></li>
    <li><a href="/editor" class="nav-cta">+ novo bot</a></li>
  </ul>
  <div class="user-menu">
    <img src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.username) + '&background=39d353&color=080b0f&bold=true' %>" alt="avatar" class="user-avatar" id="user-avatar">
    <div class="dropdown-menu" id="dropdown-menu">
      <a href="/logout">sair →</a>
    </div>
  </div>
</nav>

<div class="dash-hero">
  <div class="dash-hero-inner">
    <div class="dash-greeting">
      <h1>olá, <em><%= user.username %></em></h1>
      <p>// <%= bots.length %> bot<%= bots.length !== 1 ? 's' : '' %> registado<%= bots.length !== 1 ? 's' : '' %></p>
    </div>
  </div>
</div>

<div class="dash-content">
  <div class="dash-grid">
    <div class="card">
      <h3>upload de ficheiro</h3>
      <form action="/bot/upload" method="POST" enctype="multipart/form-data" class="upload-form">
        <div class="form-field">
          <label>nome</label>
          <input type="text" name="botname" placeholder="ex: meu-bot">
        </div>
        <div class="form-field">
          <label>linguagem</label>
          <select name="lang">
            <option value="python">python</option>
            <option value="java">java</option>
          </select>
        </div>
        <div class="form-field">
          <label>ficheiro</label>
          <input type="file" id="botfile" name="botfile" accept=".py,.java" required style="display:none">
          <label for="botfile" class="file-label" id="file-label">clica para escolher .py ou .java</label>
        </div>
        <button type="submit" class="btn-primary">upload & deploy</button>
      </form>
    </div>

    <div class="card" style="display:flex; flex-direction:column; justify-content:center; gap:16px;">
      <h3>editor de código</h3>
      <p style="font-size:0.82rem; color:var(--text-dim); line-height:1.6;">Escreve, corre e gere os teus bots diretamente no browser com output em tempo real.</p>
      <a href="/editor" class="btn-hero" style="align-self:flex-start;">abrir editor →</a>
    </div>
  </div>

  <div class="dash-section-header">
    <div>
      <h2>os meus bots</h2>
      <p><%= bots.length %> registado<%= bots.length !== 1 ? 's' : '' %></p>
    </div>
  </div>

  <% if (bots.length === 0) { %>
    <div class="empty-state">
      <span class="empty-icon">🤖</span>
      <h3>sem bots ainda</h3>
      <p>faz upload de um ficheiro ou abre o editor para criar o teu primeiro bot.</p>
      <a href="/editor" class="btn-primary">abrir editor</a>
    </div>
  <% } else { %>
    <div class="bots-list">
      <% bots.forEach(function(bot) { %>
        <div class="bot-item" id="bot-<%= bot._id %>">
          <div class="bot-info">
            <h4><%= bot.name %></h4>
            <p><%= bot.filename %> · <%= bot.lang %></p>
            <div class="log-box" id="log-<%= bot._id %>"></div>
          </div>
          <div class="bot-controls">
            <span class="status-badge <%= bot.status === 'running' ? 'online' : 'offline' %>" id="badge-<%= bot._id %>">
              <%= bot.status === 'running' ? 'online' : 'offline' %>
            </span>
            <a href="/editor?bot=<%= bot._id %>" class="btn-edit">editar</a>
            <button class="btn-primary" onclick="startBot('<%= bot._id %>')" id="start-<%= bot._id %>" <%= bot.status === 'running' ? 'style="display:none"' : '' %>>▶ iniciar</button>
            <button class="btn-secondary" onclick="stopBot('<%= bot._id %>')" id="stop-<%= bot._id %>" <%= bot.status !== 'running' ? 'style="display:none"' : '' %>>■ parar</button>
            <button class="btn-danger" onclick="deleteBot('<%= bot._id %>')">apagar</button>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<footer>
  <span class="duck-icon">🦆</span>
  <span>© 2026 duckcoding</span>
</footer>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  socket.emit("join", "<%= user._id %>");

  socket.on("log", function(data) {
    const box = document.getElementById("log-" + data.botId);
    if (!box) return;
    box.classList.add("active");
    const span = document.createElement("span");
    if (data.type === "err") span.className = "log-err";
    if (data.type === "sys") span.className = "log-sys";
    span.textContent = data.msg;
    box.appendChild(span);
    box.scrollTop = box.scrollHeight;
  });

  function startBot(botId) {
    fetch("/bot/start/" + botId, { method: "POST" })
      .then(r => r.json())
      .then(d => {
        if (d.ok) {
          document.getElementById("start-" + botId).style.display = "none";
          document.getElementById("stop-" + botId).style.display = "inline-block";
          const b = document.getElementById("badge-" + botId);
          b.textContent = "online"; b.className = "status-badge online";
        }
      });
  }

  function stopBot(botId) {
    fetch("/bot/stop/" + botId, { method: "POST" })
      .then(r => r.json())
      .then(d => {
        if (d.ok) {
          document.getElementById("stop-" + botId).style.display = "none";
          document.getElementById("start-" + botId).style.display = "inline-block";
          const b = document.getElementById("badge-" + botId);
          b.textContent = "offline"; b.className = "status-badge offline";
        }
      });
  }

  function deleteBot(botId) {
    if (!confirm("apagar este bot?")) return;
    fetch("/bot/delete/" + botId, { method: "POST" })
      .then(r => r.json())
      .then(d => { if (d.ok) document.getElementById("bot-" + botId).remove(); });
  }

  document.getElementById("botfile").addEventListener("change", function() {
    document.getElementById("file-label").textContent = this.files[0] ? this.files[0].name : "clica para escolher .py ou .java";
  });

  const avatar = document.getElementById("user-avatar");
  const dropdown = document.getElementById("dropdown-menu");
  avatar.addEventListener("click", function() {
    dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
  });
  window.addEventListener("click", function(e) {
    if (!avatar.contains(e.target) && !dropdown.contains(e.target)) dropdown.style.display = "none";
  });
</script>
</body>
</html>